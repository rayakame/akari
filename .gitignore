apps/apple/AkariKit/Frameworks/
apps/apple/AkariKit/Sources/AkariFFI/Generated/
# The macOS app's project, generated by XcodeGen from apps/macos/project.yml
apps/macos/Akari.xcodeproj/
# The developer's own team ID for signing
apps/macos/Config/Local.xcconfig
xcuserdata/
*.xcuserstate
DerivedData/
.build/
.swiftpm/

# Gradle / Android
.gradle/
apps/android/**/build/
local.properties
.cxx/
.externalNativeBuild/
