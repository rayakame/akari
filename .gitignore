# Rust
target/

# Secrets: tokens must never be committed
.env
.env.*
!.env.example
.envrc
*.token
token.txt
tokens/

# Captured gateway payloads hold personal data and secrets
captures/

# Local caches hold real messages
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# macOS
.DS_Store

